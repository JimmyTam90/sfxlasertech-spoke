# Optional analytics. Leave empty to keep an integration disabled.
# Values are public (NEXT_PUBLIC_*) and inlined at build time. Set them in Vercel project settings.
# Placeholder values containing "XXXX" are ignored by the app.

# Google Analytics 4 measurement ID, e.g. G-ABC123DEF4
NEXT_PUBLIC_GA4_ID=

# Google Ads conversion (both required to fire the affiliate-click conversion)
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LABEL=

# Meta Pixel ID (digits only)
NEXT_PUBLIC_META_PIXEL_ID=
